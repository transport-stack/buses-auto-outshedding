# API URLs
FLEET_API_URL=https://example.com/fleet_api_endpoint
GPS_DTC_API_URL=https://example.com/gps_dtc_endpoint
GPS_DIMTS_API_URL=https://example.com/gps_dimts_endpoint
DUTY_MASTER_API_URL=https://example.com/duty_master_endpoint

# Data Storage
DATA_DIR=./data/

# Application Settings
POLLING_INTERVAL=10  # Time in seconds between GPS data polling
DISTANCE_THRESHOLD_OUT=0.3  # Distance in km to consider a bus has left depot
DISTANCE_THRESHOLD_IN=0.05  # Distance in km to consider a bus has entered depot
DATA_MISSING_THRESHOLD=360  # Time in minutes to flag missing data
